PORT=
MONGO_URI=
# Opcional: DB para los tests. Si falta, se usa MONGO_URI con sufijo "-test"
# en el nombre de la base (los tests borran colecciones enteras).
MONGO_URI_TEST=
TOKEN_SECRET=
CLIENT_URLS=

# Cloudinary (F11.3) — dashboard: https://console.cloudinary.com/ → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional (default: marketplace/products)
CLOUDINARY_FOLDER=

# SMTP (F11.4) — opcional: sin config los emails quedan deshabilitados
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Sentry (F11.5) — opcional: sin DSN el error monitoring queda deshabilitado
# DSN: https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=
# Opcional (default: NODE_ENV)
SENTRY_ENVIRONMENT=

# Mercado Pago (F12 — pagos)
# URL pública del backend para el notification_url del webhook (opcional en local)
API_PUBLIC_URL=
# Secreto para validar la firma (x-signature) del webhook. Opcional: sin él la
# firma no se verifica (en local); en producción, tomalo del panel de Mercado Pago.
MP_WEBHOOK_SECRET=

# Google OAuth (login con Google) — opcional: sin él, el login con Google queda
# deshabilitado (el login tradicional sigue funcionando).
# Se obtiene en Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Debe ser el MISMO valor que NEXT_PUBLIC_GOOGLE_CLIENT_ID del frontend.
GOOGLE_CLIENT_ID=
